{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Запустить парковку",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/project.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Проверить проект",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/project.ps1",
        "test"
      ],
      "group": "test",
      "problemMatcher": []
    }
  ]
}
